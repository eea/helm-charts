{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$|^$",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$|^$",
      "maxLength": 63
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "goldpinger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "refreshInterval": {
          "type": "integer",
          "minimum": 1
        },
        "pingNumber": {
          "type": "integer",
          "minimum": 0
        },
        "displayNodeName": {
          "type": "boolean"
        },
        "pingTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "checkTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "checkAllTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "dnsTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "tcpTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "httpTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "dnsTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "uniqueItems": true
        },
        "tcpTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "uniqueItems": true
        },
        "httpTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+$"
          },
          "uniqueItems": true
        },
        "udp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "packetCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "packetSize": {
              "type": "integer",
              "minimum": 16,
              "maximum": 1400
            },
            "timeout": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "updateStrategy": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "checksum/config"
          ]
        }
      }
    },
    "podLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "app.kubernetes.io/name",
            "app.kubernetes.io/instance"
          ]
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "app.kubernetes.io/name",
                "app.kubernetes.io/instance",
                "helm.sh/chart",
                "app.kubernetes.io/version",
                "app.kubernetes.io/managed-by"
              ]
            }
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "app.kubernetes.io/name",
                "app.kubernetes.io/instance",
                "helm.sh/chart",
                "app.kubernetes.io/version",
                "app.kubernetes.io/managed-by"
              ]
            }
          }
        },
        "for": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string"
        },
        "datasourceUid": {
          "type": "string",
          "minLength": 1
        },
        "uid": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_-]*$"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "app.kubernetes.io/name",
                "app.kubernetes.io/instance",
                "helm.sh/chart",
                "app.kubernetes.io/version",
                "app.kubernetes.io/managed-by"
              ]
            }
          }
        }
      }
    },
    "rancherNavLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "target": {
          "enum": [
            "_blank",
            "_self"
          ]
        }
      },
      "required": [
        "enabled",
        "label",
        "group",
        "target"
      ]
    }
  }
}
