{
  "uid": "__DASHBOARD_UID__",
  "title": "EEA Goldpinger - __RELEASE__",
  "tags": [
    "eea",
    "goldpinger",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scraped instances",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "description": "Count of scrapeable instances, not a node-coverage guarantee. Compare DaemonSet desired/current/ready counts.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\"})",
          "legendFormat": "{{source_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Worst unhealthy-peer count",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "description": "Largest unhealthy-peer count reported by any observer; peer and configured external checks can affect health.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(goldpinger_nodes_health_total{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",status=\"unhealthy\"})",
          "legendFormat": "{{source_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Unhealthy peers by source node",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "description": "Missing samples remain gaps. Zero does not prove discovery or node coverage is complete.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "goldpinger_nodes_health_total{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\",status=\"unhealthy\"}",
          "legendFormat": "{{source_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "title": "Peer HTTP mean response time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "description": "Successful HTTP ping duration, including application overhead. Not ICMP RTT or UDP packet loss.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_node, host_ip) (rate(goldpinger_peers_response_time_s_sum{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\",call_type=\"ping\"}[$__rate_interval])) / sum by (source_node, host_ip) (rate(goldpinger_peers_response_time_s_count{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\",call_type=\"ping\"}[$__rate_interval]))",
          "legendFormat": "{{source_node}} \u2192 {{host_ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "Health reported by source node",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "description": "Green means reported checks passed; gaps are missing data. Also inspect collection/discovery health.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "goldpinger_cluster_health_total{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\"}",
          "legendFormat": "{{source_node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failure",
                  "color": "red"
                },
                "1": {
                  "text": "Success",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "External target errors / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "__DATASOURCE_UID__"
      },
      "description": "Optional target checks; a quiet zero rate means no new errors, not necessarily that a target was configured.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source_node, host) (rate({__name__=~\"goldpinger_(dns|tcp|http)_errors_total\",namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\"}[$__rate_interval]))",
          "legendFormat": "{{source_node}} {{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 19,
      "title": "Collection and discovery health (expand when needed)",
      "type": "row",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 20,
          "title": "Scrape health by source node",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "description": "",
          "gridPos": {
            "x": 0,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "up{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\"}",
              "legendFormat": "{{source_node}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          }
        },
        {
          "id": 21,
          "title": "Discovery API errors / second",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "description": "",
          "gridPos": {
            "x": 12,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "rate(goldpinger_errors_total{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\",type=\"kubernetes_api\"}[$__rate_interval])",
              "legendFormat": "{{source_node}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          }
        },
        {
          "id": 22,
          "title": "Kubernetes API p95 response time",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "description": "",
          "gridPos": {
            "x": 0,
            "y": 33,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "histogram_quantile(0.95, sum by (le, source_node) (rate(goldpinger_kube_master_response_time_s_bucket{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\"}[$__rate_interval])))",
              "legendFormat": "{{source_node}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          }
        },
        {
          "id": 23,
          "title": "Goldpinger errors / second",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "__DATASOURCE_UID__"
          },
          "description": "",
          "gridPos": {
            "x": 12,
            "y": 33,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "expr": "rate(goldpinger_errors_total{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\",source_node=~\"$source_node\"}[$__rate_interval])",
              "legendFormat": "{{source_node}} {{type}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ops",
              "color": {
                "mode": "palette-classic"
              },
              "custom": {
                "spanNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "none"
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "source_node",
        "label": "Source node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "__DATASOURCE_UID__"
        },
        "definition": "label_values(up{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\"}, source_node)",
        "query": {
          "query": "label_values(up{namespace=\"__RELEASE_NAMESPACE__\",job=\"__JOB__\"}, source_node)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  }
}
